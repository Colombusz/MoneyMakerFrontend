# ──────────────────────────────────────────────────────────────────────
# MoneyMakerFrontend — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust for your environment.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Vite reads .env at startup — restart the dev server after editing.
# ──────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
VITE_API_URL=http://localhost:4000

# Dev-server port (Vite `server.port`).
VITE_PORT=5173